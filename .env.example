# ============================================================================
# NovaIncus Docker 部署环境配置模板
#
# 用法：
#   cp .env.example .env        # 然后填入真实值，或
#   bash scripts/init-env.sh   # 自动随机生成所有密钥（推荐）
#
# 注意：密钥类变量建议用 openssl 生成，例如：
#   openssl rand -hex 24                       # 密码类
#   printf 'A1!%s' "$(openssl rand -hex 48)" | cut -c1-64   # JWT_SECRET（≥32字符，至少3类字符）
#   openssl rand -base64 32                    # ENCRYPTION_KEY（上线后必须稳定保存，勿随意更换）
# ============================================================================

# ============ 数据库配置 ============
POSTGRES_USER=incudal
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=incudal

# ============ Redis 配置 ============
REDIS_PASSWORD=CHANGE_ME_redis_password

# ============ 安全配置（必须修改！）============
JWT_SECRET=CHANGE_ME_jwt_secret_min_32_chars
COOKIE_SECRET=CHANGE_ME_cookie_secret
ENCRYPTION_KEY=CHANGE_ME_encryption_key_base64

# ============ 应用配置 ============
APP_PORT=3000
ADMIN_PASSWORD=CHANGE_ME_admin_password
LOG_LEVEL=info
DISABLE_REQUEST_LOG=true

# ============ 面板访问地址（节点注册/支付回调依赖，强烈建议配置）============
# 例如：FRONTEND_URL=https://panel.example.com
FRONTEND_URL=

# ============ 支付回调（前后端分域时配置）============
# PAYMENT_CALLBACK_BASE_URL=https://api.example.com
# PAYMENT_CALLBACK_IP_WHITELIST=
# PAYMENT_CALLBACK_SKIP_IP_WHITELIST=false

# ============ 监控告警（可选）============
# ALERT_WEBHOOK_URL=

# ============ 数据库稳定性调优（可选）============
# DB_POOL_MAX=20
# DB_POOL_MIN=5
# DB_CONNECTION_TIMEOUT=5000
# DB_IDLE_TIMEOUT=30000
# DB_STATEMENT_TIMEOUT=30000
# DB_QUERY_TIMEOUT=30000
# TRAFFIC_CONCURRENCY_PER_HOST=10
# TRAFFIC_HOST_CONCURRENCY=3
# DB_WORKER_BACKOFF_MS=15000
